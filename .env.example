# Copy to .env and change the values. Never commit .env.
# docker compose works without a .env file, using local defaults.

# PostgreSQL (db container)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=urlshortener

# API
NODE_ENV=development
# Public address of the web container, used to build short links
BASE_URL=http://localhost:8080
# Random string used to hash visitor IPs. Use a long random value on servers.
IP_HASH_SALT=change-me
# Links one IP address can create per minute
RATE_LIMIT_PER_MINUTE=20

# Set by CI on real builds. Shown by /health (and later the footer).
GIT_SHA=dev
BUILD_TIME=

# Only needed when running the API outside Docker (npm run dev in backend/)
# DATABASE_URL=postgres://app:change-me@localhost:5432/urlshortener
